# Postgres connection string
DATABASE_URL=

# Google OAuth client (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: OpenAI-compatible endpoint for development (e.g. Gemini, Ollama).
# Leave empty to use the OpenAI API.
OPENAI_BASE_URL=

# Auth.js session encryption. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Separate database used only by tests (npm test). It is reset on every test run.
TEST_DATABASE_URL=